---
import type { SkillGroup } from '../lib/groups';
import { renderInline } from '../lib/markdown';
import BundleMark from './BundleMark.astro';

interface Props {
  group: SkillGroup;
  index: number;
}

const { group, index } = Astro.props;
const skillLabel = group.skills.length === 1 ? 'skill' : 'skills';
---

<button
  type="button"
  class="group-card"
  style={`--i:${index}`}
  data-group-card={group.id}
  data-bundle-accent={group.visual.accent}
  aria-label={`${group.title} — ${group.skills.length} ${group.skills.length === 1 ? 'skill' : 'skills'}`}
>
  <span class="group-card__mark" aria-hidden="true">
    <BundleMark visual={group.visual} size="compact" />
  </span>
  <h2 class="group-card__title">{group.title}</h2>
  <p class="group-card__description" set:html={renderInline(group.description)} />
  <p class="group-card__meta">
    {group.skills.length} {skillLabel}
  </p>
</button>

<style>
  .group-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 1.125rem 3.25rem 1.25rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }

  .group-card[data-bundle-accent='blue']:hover {
    border-color: rgb(45 118 255 / 55%);
  }

  .group-card[data-bundle-accent='violet']:hover {
    border-color: rgb(101 60 189 / 55%);
  }

  .group-card[data-bundle-accent='cyan']:hover {
    border-color: rgb(0 199 253 / 45%);
  }

  .group-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
  }

  .group-card:active {
    transform: translateY(-1px) scale(0.995);
  }

  .group-card__mark {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    pointer-events: none;
  }

  .group-card__title {
    margin: 0;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .group-card__description {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
  }

  .group-card__description :global(code) {
    padding: 0.05em 0.25em;
    border-radius: 4px;
    background: var(--badge-neutral-bg);
  }

  .group-card__meta {
    margin: auto 0 0;
    padding-top: 0.25rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
</style>
