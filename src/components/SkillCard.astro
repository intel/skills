---
import BadgeList from './BadgeList.astro';
import type { Skill } from '../lib/skills';
import { renderInline } from '../lib/markdown';

interface Props {
  skill: Skill;
}

const { skill } = Astro.props;
---

<button
  type="button"
  class="card"
  data-skill-card={skill.name}
  aria-haspopup="dialog"
  aria-label={`${skill.name} — show install details`}
>
  <h2 class="card__name">{skill.name}</h2>
  <p class="card__summary" set:html={renderInline(skill.summary)} />
  <div class="card__badges">
    <BadgeList skill={skill} maxProducts={3} />
  </div>
</button>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 1.125rem 1.25rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: var(--shadow-card-hover);
  }

  .card:active {
    transform: translateY(-1px) scale(0.995);
  }

  .card__name {
    margin: 0;
    color: var(--text);
    font-size: 1.0625rem;
    /* 500 is the heaviest real cut of IntelOne Text. */
    font-weight: 500;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .card__summary {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--text-muted);
    font-size: 0.875rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
  }

  /* Pins the badges to the bottom so cards in a row line up. */
  .card__badges {
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .card__summary :global(code) {
    padding: 0.05em 0.25em;
    border-radius: 4px;
    background: var(--badge-neutral-bg);
  }
</style>
