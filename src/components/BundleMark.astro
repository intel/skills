---
import BundleIcon from './BundleIcon.astro';
import type { BundleVisual } from '../lib/bundle-visuals';

interface Props {
  visual: BundleVisual;
  /** Larger mark for the bundle detail header. */
  size?: 'card' | 'hero' | 'compact';
}

const { visual, size = 'card' } = Astro.props;
---

<div class:list={['bundle-mark', `bundle-mark--${size}`]} data-accent={visual.accent}>
  <BundleIcon variant={visual.icon} class="bundle-mark__icon" />
</div>

<style>
  .bundle-mark {
    display: grid;
    place-items: center;
    flex: none;
    border-radius: 11px;
    border: 1px solid transparent;
    background:
      radial-gradient(circle at 30% 20%, rgb(255 255 255 / 10%), transparent 55%),
      var(--mark-bg);
    color: var(--mark-fg);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 6%);
  }

  .bundle-mark--card {
    width: 2.75rem;
    height: 2.75rem;
  }

  .bundle-mark--compact {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9px;
  }

  .bundle-mark--compact :global(.bundle-mark__icon) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .bundle-mark--hero {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 13px;
  }

  .bundle-mark--hero :global(.bundle-mark__icon) {
    width: 1.625rem;
    height: 1.625rem;
  }

  .bundle-mark[data-accent='blue'] {
    --mark-bg: linear-gradient(145deg, #10254f 0%, #0a1b3a 100%);
    --mark-fg: #6ea8ff;
    border-color: rgb(45 118 255 / 35%);
  }

  .bundle-mark[data-accent='violet'] {
    --mark-bg: linear-gradient(145deg, #24164a 0%, #0f1a36 100%);
    --mark-fg: #b794ff;
    border-color: rgb(101 60 189 / 35%);
  }

  .bundle-mark[data-accent='cyan'] {
    --mark-bg: linear-gradient(145deg, #0a2a3a 0%, #0a1b3a 100%);
    --mark-fg: #4de4ff;
    border-color: rgb(0 199 253 / 30%);
  }
</style>
