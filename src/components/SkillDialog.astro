---
import BadgeList from './BadgeList.astro';
import GithubIcon from './GithubIcon.astro';
import InstallCommand from './InstallCommand.astro';
import type { Skill } from '../lib/skills';
import { renderInline } from '../lib/markdown';

interface Props {
  skill: Skill;
}

const { skill } = Astro.props;
const titleId = `skill-dialog-title-${skill.name}`;
---

<dialog class="dialog" data-skill-dialog={skill.name} aria-labelledby={titleId}>
  <form method="dialog" class="dialog__dismiss">
    <button type="submit" class="dialog__close" aria-label="Close">
      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path
          d="M5 5l10 10M15 5L5 15"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </form>

  <h2 class="dialog__name" id={titleId}>{skill.name}</h2>

  <div class="dialog__badges">
    <BadgeList skill={skill} />
  </div>

  <p class="dialog__description" set:html={renderInline(skill.description)} />

  <section class="dialog__section">
    <h3 class="dialog__heading">Install this skill</h3>
    <InstallCommand command={skill.installCommand} />
  </section>

  <section class="dialog__section">
    <h3 class="dialog__heading">Source</h3>
    <a class="source" href={skill.sourceUrl} target="_blank" rel="noopener noreferrer">
      <GithubIcon class="source__icon" />
      <span>View source on GitHub</span>
    </a>
  </section>
</dialog>

<style>
  .dialog {
    width: min(38rem, calc(100vw - 2rem));
    max-height: min(44rem, calc(100vh - 4rem));
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-raised);
    box-shadow: var(--shadow-dialog);
    color: var(--text);
    overflow-y: auto;
  }

  .dialog[open] {
    animation: dialog-in 0.26s cubic-bezier(0.22, 0.7, 0.28, 1);
  }

  .dialog::backdrop {
    background: rgb(0 8 24 / 62%);
    backdrop-filter: blur(3px);
  }

  .dialog[open]::backdrop {
    animation: backdrop-in 0.26s ease;
  }

  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.97);
    }
  }

  /* The blur is animated as well as the tint, so the grid behind settles out of
     focus rather than snapping. */
  @keyframes backdrop-in {
    from {
      opacity: 0;
      backdrop-filter: blur(0);
    }
  }

  .dialog__dismiss {
    float: right;
    margin: -0.375rem -0.375rem 0 0.75rem;
  }

  .dialog__close {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }

  .dialog__close:hover {
    border-color: var(--border);
    background: var(--badge-neutral-bg);
    color: var(--text);
  }

  .dialog__close svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .dialog__name {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .dialog__badges {
    margin-bottom: 1rem;
  }

  .dialog__description {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .dialog__description :global(code) {
    padding: 0.05em 0.25em;
    border-radius: 4px;
    background: var(--badge-neutral-bg);
  }

  .dialog__description :global(strong) {
    color: var(--text);
  }

  .dialog__section {
    margin-top: 1.5rem;
  }

  /* intel.com labels small metadata in sentence case rather than uppercase
     micro-caps, as in the product-spec table's column headers. */
  .dialog__heading {
    margin: 0 0 0.5rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 400;
  }

  .source {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--link-external);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }

  .source:hover span {
    text-decoration: underline;
  }

  /* Scoped styles do not reach into a child component's markup, so this has to
     be :global to match the icon GithubIcon renders. */
  .source :global(.source__icon) {
    width: 1rem;
    height: 1rem;
    flex: none;
  }
</style>
